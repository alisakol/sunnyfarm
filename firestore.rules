rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Default Deny
    match /{document=**} {
      allow read, write: if false;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidUserProfile(data) {
      return data.id is string &&
        data.id == request.auth.uid &&
        (!('email' in data) || (data.email is string && data.email.size() <= 128)) &&
        (!('displayName' in data) || (data.displayName is string && data.displayName.size() <= 128)) &&
        (!('photoURL' in data) || (data.photoURL is string && data.photoURL.size() <= 512)) &&
        (!('farmName' in data) || (data.farmName is string && data.farmName.size() <= 128)) &&
        (!('level' in data) || (data.level is number && data.level >= 1)) &&
        (!('reputation' in data) || (data.reputation is number && data.reputation >= 0)) &&
        (!('specialty' in data) || (data.specialty is string && data.specialty.size() <= 128)) &&
        (!('bio' in data) || (data.bio is string && data.bio.size() <= 500)) &&
        (!('createdAt' in data) || (data.createdAt is string && data.createdAt.size() <= 64)) &&
        (!('lastLoginAt' in data) || (data.lastLoginAt is string && data.lastLoginAt.size() <= 64));
    }

    function isValidFarmSave(data) {
      return data.userId is string &&
        data.userId == request.auth.uid &&
        data.gameData is string &&
        data.gameData.size() <= 500000 &&
        data.updatedAt is string &&
        data.updatedAt.size() <= 64 &&
        (!('level' in data) || data.level is number) &&
        (!('coins' in data) || data.coins is number) &&
        (!('gems' in data) || data.gems is number) &&
        (!('xp' in data) || data.xp is number) &&
        (!('barnCapacity' in data) || data.barnCapacity is number);
    }

    function isValidFriend(data) {
      return data.id is string &&
        data.friendUid is string &&
        data.friendUid.size() <= 128 &&
        (!('displayName' in data) || (data.displayName is string && data.displayName.size() <= 128)) &&
        (!('photoURL' in data) || (data.photoURL is string && data.photoURL.size() <= 512)) &&
        (!('farmName' in data) || (data.farmName is string && data.farmName.size() <= 128)) &&
        (!('level' in data) || data.level is number) &&
        (!('addedAt' in data) || (data.addedAt is string && data.addedAt.size() <= 64));
    }

    function isValidChat(data) {
      return data.id is string &&
        data.participants is list &&
        data.participants.size() >= 2 &&
        data.participants.size() <= 10 &&
        request.auth.uid in data.participants &&
        (!('lastMessageText' in data) || (data.lastMessageText is string && data.lastMessageText.size() <= 1000)) &&
        (!('lastMessageSenderId' in data) || (data.lastMessageSenderId is string && data.lastMessageSenderId.size() <= 128)) &&
        (!('lastMessageAt' in data) || (data.lastMessageAt is string && data.lastMessageAt.size() <= 64)) &&
        (!('updatedAt' in data) || (data.updatedAt is string && data.updatedAt.size() <= 64));
    }

    function isValidChatMessage(data, cId) {
      return data.id is string &&
        data.chatId is string &&
        data.chatId == cId &&
        data.senderId is string &&
        data.senderId == request.auth.uid &&
        data.senderName is string &&
        data.senderName.size() <= 128 &&
        (!('senderPhoto' in data) || (data.senderPhoto is string && data.senderPhoto.size() <= 512)) &&
        data.text is string &&
        data.text.size() > 0 &&
        data.text.size() <= 1000 &&
        data.createdAt is string &&
        data.createdAt.size() <= 64 &&
        (!('timestamp' in data) || data.timestamp is number);
    }

    function isValidGift(data) {
      return data.id is string &&
        data.recipientUid is string &&
        data.recipientUid.size() <= 128 &&
        data.senderUid is string &&
        data.senderUid == request.auth.uid &&
        data.senderName is string &&
        data.senderName.size() <= 128 &&
        (!('senderAvatar' in data) || (data.senderAvatar is string && data.senderAvatar.size() <= 512)) &&
        (!('senderLevel' in data) || data.senderLevel is number) &&
        data.giftType in ['seeds', 'fertilizer', 'coins', 'gems', 'pie'] &&
        data.giftName is string &&
        data.giftName.size() <= 128 &&
        data.giftEmoji is string &&
        data.giftEmoji.size() <= 32 &&
        data.count is number &&
        data.count >= 1 &&
        data.count <= 1000 &&
        (!('note' in data) || (data.note is string && data.note.size() <= 300)) &&
        (!('timestamp' in data) || (data.timestamp is string && data.timestamp.size() <= 64)) &&
        (!('createdAt' in data) || (data.createdAt is string && data.createdAt.size() <= 64)) &&
        data.claimed is bool;
    }

    function isValidVisit(data) {
      return data.id is string &&
        data.recipientUid is string &&
        data.visitorUid is string &&
        data.visitorUid == request.auth.uid &&
        data.visitorName is string &&
        data.visitorName.size() <= 128 &&
        (!('visitorAvatar' in data) || (data.visitorAvatar is string && data.visitorAvatar.size() <= 512)) &&
        (!('visitorLevel' in data) || data.visitorLevel is number) &&
        data.action in ['watered', 'petted', 'gifted', 'left_note', 'admired'] &&
        data.actionText is string &&
        data.actionText.size() <= 300 &&
        (!('timestamp' in data) || (data.timestamp is string && data.timestamp.size() <= 64)) &&
        (!('createdAt' in data) || (data.createdAt is string && data.createdAt.size() <= 64)) &&
        (!('rewardClaimed' in data) || data.rewardClaimed is bool);
    }

    // Connection health check document
    match /test/{testId} {
      allow get: if isValidId(testId);
    }

    // User Profile: Readable by any signed-in player for discovery & friends; writable only by owner
    match /users/{userId} {
      allow get: if isValidId(userId) && isSignedIn();
      allow list: if isSignedIn();
      allow create: if isValidId(userId) && isOwner(userId) && isValidUserProfile(incoming());
      allow update: if isValidId(userId) && isOwner(userId) && isValidUserProfile(incoming()) &&
        incoming().id == existing().id;
      allow delete: if isValidId(userId) && isOwner(userId);

      // Friends subcollection
      match /friends/{friendId} {
        allow get: if isValidId(userId) && isValidId(friendId) && isOwner(userId);
        allow list: if isValidId(userId) && isOwner(userId);
        allow create: if isValidId(userId) && isValidId(friendId) && isOwner(userId) && isValidFriend(incoming());
        allow update: if isValidId(userId) && isValidId(friendId) && isOwner(userId) && isValidFriend(incoming());
        allow delete: if isValidId(userId) && isValidId(friendId) && isOwner(userId);
      }

      // Gifts subcollection: Signed-in players can send gifts; recipient can read, list, update (claim) & delete
      match /gifts/{giftId} {
        allow get: if isValidId(userId) && isValidId(giftId) && isOwner(userId);
        allow list: if isValidId(userId) && isOwner(userId);
        allow create: if isValidId(userId) && isValidId(giftId) && isSignedIn() &&
          incoming().recipientUid == userId &&
          incoming().senderUid == request.auth.uid &&
          isValidGift(incoming());
        allow update: if isValidId(userId) && isValidId(giftId) && isOwner(userId) &&
          incoming().recipientUid == existing().recipientUid &&
          incoming().senderUid == existing().senderUid;
        allow delete: if isValidId(userId) && isValidId(giftId) && isOwner(userId);
      }

      // Visits subcollection: Visitors can log interactions; recipient can read, list, claim & delete
      match /visits/{visitId} {
        allow get: if isValidId(userId) && isValidId(visitId) && isOwner(userId);
        allow list: if isValidId(userId) && isOwner(userId);
        allow create: if isValidId(userId) && isValidId(visitId) && isSignedIn() &&
          incoming().recipientUid == userId &&
          incoming().visitorUid == request.auth.uid &&
          isValidVisit(incoming());
        allow update: if isValidId(userId) && isValidId(visitId) && isOwner(userId);
        allow delete: if isValidId(userId) && isValidId(visitId) && isOwner(userId);
      }

      // Game Saves subcollection for cross-device sync
      match /saves/{saveId} {
        allow get: if isValidId(userId) && isValidId(saveId) && isOwner(userId);
        allow list: if isValidId(userId) && isOwner(userId);
        allow create: if isValidId(userId) && isValidId(saveId) && isOwner(userId) && isValidFarmSave(incoming());
        allow update: if isValidId(userId) && isValidId(saveId) && isOwner(userId) && isValidFarmSave(incoming()) &&
          incoming().userId == existing().userId;
        allow delete: if isValidId(userId) && isValidId(saveId) && isOwner(userId);
      }
    }

    // Real-time Chat between friends
    match /chats/{chatId} {
      allow get: if isValidId(chatId) && isSignedIn() &&
        (request.auth.uid in resource.data.participants);
      allow list: if isSignedIn();
      allow create: if isValidId(chatId) && isSignedIn() && isValidChat(incoming());
      allow update: if isValidId(chatId) && isSignedIn() &&
        (request.auth.uid in resource.data.participants) &&
        isValidChat(incoming()) &&
        incoming().participants == existing().participants;
      allow delete: if isValidId(chatId) && isSignedIn() &&
        (request.auth.uid in resource.data.participants);

      match /messages/{messageId} {
        allow get: if isValidId(chatId) && isValidId(messageId) && isSignedIn() &&
          (request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.participants);
        allow list: if isValidId(chatId) && isSignedIn() &&
          (request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.participants);
        allow create: if isValidId(chatId) && isValidId(messageId) && isSignedIn() &&
          (request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.participants) &&
          isValidChatMessage(incoming(), chatId);
        allow delete: if isValidId(chatId) && isValidId(messageId) && isSignedIn() &&
          (resource.data.senderId == request.auth.uid);
      }
    }
  }
}
